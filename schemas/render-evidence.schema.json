{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hash-bound page render evidence",
  "type": "object",
  "required": ["schema_version", "tool_capabilities", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool_capabilities": {
      "type": "object",
      "required": ["pdftoppm", "docx_renderer", "python"],
      "properties": {
        "pdftoppm": {"$ref": "#/$defs/renderer_identity"},
        "docx_renderer": {"$ref": "#/$defs/renderer_identity"},
        "python": {"$ref": "#/$defs/renderer_identity"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "source", "format", "sha256", "pages"],
        "properties": {
          "id": {"enum": ["resume_pdf", "resume_docx", "cover_letter_pdf", "cover_letter_docx"]},
          "source": {"type": "string", "minLength": 1},
          "format": {"enum": ["pdf", "docx"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["page", "path", "sha256", "bytes"],
              "properties": {
                "page": {"type": "integer", "minimum": 1},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "bytes": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "renderer_identity": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "available": {"type": "boolean"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
