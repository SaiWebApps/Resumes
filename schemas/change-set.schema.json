{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact change set",
  "type": "object",
  "required": ["schema_version", "changes", "accepted_regions", "collateral_change_ids", "visual_evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target_ids", "invalidates"],
        "properties": {
          "id": {"type": "string"},
          "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "invalidates": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "accepted_regions": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "sha256", "description"], "properties": {"artifact_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "description": {"type": "string", "minLength": 1}}}},
    "collateral_change_ids": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "visual_evidence": {
      "type": "object",
      "required": ["reviewed_change_ids", "after_page_hashes"],
      "properties": {
        "reviewed_change_ids": {"type": "array", "items": {"type": "string"}},
        "after_page_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    }
  }
}
