{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rendered artifact manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "renderer_identities", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "renderer_identities": {
      "type": "object",
      "required": ["pdftoppm", "docx_renderer", "python"],
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id", "filename", "format", "sha256", "semantic_text_sha256",
          "semantic_word_count", "external_links", "emphasis_sha256",
          "emphasis_word_count", "accessibility", "pages", "page_images"
        ],
        "properties": {
          "id": {"enum": ["resume_pdf", "resume_docx", "cover_letter_pdf", "cover_letter_docx"]},
          "filename": {"type": "string"},
          "format": {"enum": ["pdf", "docx"]},
          "sha256": {"type": "string"},
          "semantic_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_word_count": {"type": "integer", "minimum": 1},
          "external_links": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(https?://|mailto:|tel:).+"}
          },
          "emphasis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "emphasis_word_count": {"type": "integer", "minimum": 0},
          "accessibility": {
            "type": "object",
            "required": [
              "checked", "encrypted", "text_extractable", "document_title",
              "document_language", "external_link_targets_valid",
              "nontext_object_count", "nontext_alt_text_complete", "tagged",
              "reading_order_sha256"
            ],
            "properties": {
              "checked": {"const": true},
              "encrypted": {"type": "boolean"},
              "text_extractable": {"type": "boolean"},
              "document_title": {"type": "string"},
              "document_language": {"type": ["string", "null"]},
              "external_link_targets_valid": {"type": "boolean"},
              "nontext_object_count": {"type": "integer", "minimum": 0},
              "nontext_alt_text_complete": {"type": "boolean"},
              "tagged": {"type": ["boolean", "null"]},
              "reading_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "pages": {"type": "integer", "minimum": 1},
          "page_images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["page", "path", "sha256", "bytes"],
              "properties": {
                "page": {"type": "integer", "minimum": 1},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "bytes": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
